# Copy to .env and fill in. Never commit the real .env.

SUPABASE_URL=https://<project>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Service-role key (Dashboard -> Settings -> API -> Secret keys). Required for
# native email/password auth: the API uses it to read/write the
# native_credentials table and to store avatar uploads. Server-only.
SUPABASE_SECRET_KEY=sb_secret_...

# Optional. Signs native session tokens; falls back to SUPABASE_SECRET_KEY.
# Set a stable random value (e.g. `openssl rand -hex 32`) so token signing is
# independent of key rotation.
# AUTH_SESSION_SECRET=

PORT=3000
