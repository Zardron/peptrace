# Copy to .env and fill in. Never commit the real .env.

SUPABASE_URL=https://<project>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Service-role key (Dashboard -> Settings -> API -> Secret keys). Required for
# native email/password auth: the API uses it to read/write the
# native_credentials table and to store avatar uploads. Server-only.
SUPABASE_SECRET_KEY=sb_secret_...

# Optional. Signs native session tokens; falls back to SUPABASE_SECRET_KEY.
# Set a stable random value (e.g. `openssl rand -hex 32`) so token signing is
# independent of key rotation.
# AUTH_SESSION_SECRET=

# Comma-separated browser origins allowed to call the customer API.
CORS_ORIGIN=http://localhost:5173

# Admin sessions use an independent HMAC secret and HttpOnly cookies.
ADMIN_CORS_ORIGINS=http://localhost:5173
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
# Used once when admin_users is empty. Remove the password after bootstrap.
ADMIN_BOOTSTRAP_EMAIL=owner@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-unique-password-of-12-or-more-characters
ADMIN_BOOTSTRAP_NAME=PepTrace Owner

PORT=3000
