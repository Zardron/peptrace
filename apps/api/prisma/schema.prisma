generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ClientTenant {
  id              String           @id @default(uuid())
  name            String
  slug            String           @unique
  plan            String
  status          String
  owner           String
  seats           Int
  monthlySpend    Int
  openItems       Int
  dataRegion      String
  lastActivityAt  DateTime
  adminUsers      AdminUser[]
  secrets         Secret[]
  secretGrants    SecretAccessGrant[]
  secretAuditEvents SecretAuditEvent[]
  whiteLabelPanel WhiteLabelPanel?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model WhiteLabelPanel {
  id                    String       @id @default(uuid())
  clientTenantId        String       @unique
  clientTenant          ClientTenant @relation(fields: [clientTenantId], references: [id], onDelete: Cascade)
  brandName             String
  productName           String
  industry              String
  accentColor           String
  overviewTitle         String
  overviewDescription   String
  operationsTitle       String
  operationsDescription String
  primaryRecords        Json
  workItems             Json
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

model AdminUser {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  displayName  String
  role         String        @default("owner")
  isActive     Boolean       @default(true)
  tenantId     String?
  tenant       ClientTenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  secretGrants SecretAccessGrant[]
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Secret {
  id             String              @id @default(uuid())
  tenantId       String
  tenant         ClientTenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  labels         Json                @default("{}")
  versionCounter Int                 @default(0)
  versions       SecretVersion[]
  grants         SecretAccessGrant[]
  auditEvents    SecretAuditEvent[]
  createdById    String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, updatedAt])
}

model SecretVersion {
  id              String             @id @default(uuid())
  secretId        String
  secret          Secret             @relation(fields: [secretId], references: [id], onDelete: Cascade)
  version         Int
  state           String             @default("ENABLED")
  encryptedValue  Bytes?
  encryptionIv    Bytes?
  authenticationTag Bytes?
  checksum        String?
  encryptionKeyId String
  createdById     String
  createdAt       DateTime           @default(now())
  destroyedAt     DateTime?
  auditEvents     SecretAuditEvent[]

  @@unique([secretId, version])
  @@index([secretId, state])
}

model SecretAccessGrant {
  id        String       @id @default(uuid())
  tenantId  String
  tenant    ClientTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  secretId  String
  secret    Secret       @relation(fields: [secretId], references: [id], onDelete: Cascade)
  userId    String
  user      AdminUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([secretId, userId])
  @@index([tenantId, userId])
}

model SecretAuditEvent {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          ClientTenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  secretId        String?
  secret          Secret?        @relation(fields: [secretId], references: [id], onDelete: SetNull)
  secretVersionId String?
  secretVersion   SecretVersion? @relation(fields: [secretVersionId], references: [id], onDelete: SetNull)
  actorId         String
  action          String
  metadata        Json           @default("{}")
  createdAt       DateTime       @default(now())

  @@index([tenantId, createdAt])
  @@index([secretId, createdAt])
}

model Vendor {
  id            String          @id @default(uuid())
  displayName   String
  slug          String          @unique
  overallRating Float
  products      VendorProduct[]
  tests         LabTest[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model VendorProduct {
  id                 String   @id @default(uuid())
  label              String
  slug               String
  peptideId          String
  vendorId           String
  priceMg            Float
  rating             Float
  doseMg             Float
  purityPercent      Float
  labelAccuracyDelta Float
  testsCount         Int
  peptide            Peptide  @relation(fields: [peptideId], references: [id], onDelete: Cascade)
  vendor             Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([vendorId, slug])
}

model Peptide {
  id        String          @id @default(uuid())
  label     String
  slug      String          @unique
  products  VendorProduct[]
  tests     LabTest[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Lab {
  id           String    @id @default(uuid())
  displayName  String
  slug         String    @unique
  partnerSince DateTime
  tests        LabTest[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model LabTest {
  id                String    @id @default(uuid())
  labId             String
  vialSizeMg        Int
  vendorId          String
  resultsReleasedAt DateTime?
  testingStatus     String
  peptideId         String
  assay             String
  purityPercent     Float?
  labelClaimPercent Float?
  lab               Lab       @relation(fields: [labId], references: [id])
  peptide           Peptide   @relation(fields: [peptideId], references: [id])
  vendor            Vendor    @relation(fields: [vendorId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model ApiSurface {
  id        String   @id @default(uuid())
  group     String   @unique
  routes    String[]
  owner     String
  readiness String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AccountWorkItem {
  id        String   @id @default(uuid())
  account   String
  kind      String
  priority  String
  dueAt     DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
