generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ClientTenant {
  id                         String                      @id @default(uuid())
  name                       String
  slug                       String                      @unique
  plan                       String
  status                     String
  owner                      String
  seats                      Int
  monthlySpend               Int
  openItems                  Int
  dataRegion                 String
  lastActivityAt             DateTime
  adminUsers                 AdminUser[]
  memberships                TenantMembership[]
  settings                   TenantSettings?
  secrets                    Secret[]
  secretGrants               SecretAccessGrant[]
  secretAuditEvents          SecretAuditEvent[]
  databaseConnection         ClientDatabaseConnection?
  backendServices            TenantBackendService[]
  shamstayProperties         ShamstayProperty[]
  shamstayGuests             ShamstayGuest[]
  shamstayReservations       ShamstayReservation[]
  shamstayTurnovers          ShamstayTurnover[]
  shamstayMaintenanceTickets ShamstayMaintenanceTicket[]
  shamstayOwnerPayouts       ShamstayOwnerPayout[]
  shamstayPayments           ShamstayPayment[]
  shamstayAvailabilityBlocks ShamstayAvailabilityBlock[]
  shamstayReviews            ShamstayReview[]
  shamstayConversations      ShamstayConversation[]
  shamstayWishlistItems      ShamstayWishlistItem[]
  realEstateListings         RealEstateListing[]
  realEstateLeads            RealEstateLead[]
  realEstateViewings         RealEstateViewing[]
  realEstateOffers           RealEstateOffer[]
  realEstateCommissions      RealEstateCommission[]
  realEstateSavedListings    RealEstateSavedListing[]
  realEstateSavedSearches    RealEstateSavedSearch[]
  peptraceBatches            PeptraceBatch[]
  peptraceCertificates       PeptraceCertificate[]
  whiteLabelPanel            WhiteLabelPanel?
  platformAuditEvents        PlatformAuditEvent[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
}

model TenantSettings {
  id               String       @id @default(uuid())
  tenantId         String       @unique
  tenant           ClientTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branding         Json         @default("{}")
  enabledModules   String[]     @default([])
  integrations     Json         @default("{}")
  limits           Json         @default("{}")
  labels           Json         @default("{}")
  businessSettings Json         @default("{}")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model ClientDatabaseConnection {
  id                 String       @id @default(uuid())
  tenantId           String       @unique
  tenant             ClientTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider           String
  displayName        String
  host               String
  port               Int
  databaseName       String
  username           String?
  passwordCiphertext Bytes?
  passwordIv         Bytes?
  passwordAuthTag    Bytes?
  passwordKeyId      String?
  sslMode            String       @default("REQUIRE")
  connectionMode     String       @default("STANDARD")
  schemaName         String?
  authSource         String?
  replicaSet         String?
  useSrv             Boolean      @default(false)
  status             String       @default("NOT_TESTED")
  lastTestedAt       DateTime?
  lastTestMessage    String?
  updatedById        String
  updatedByEmail     String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([provider, status])
}

model WhiteLabelPanel {
  id                    String       @id @default(uuid())
  clientTenantId        String       @unique
  clientTenant          ClientTenant @relation(fields: [clientTenantId], references: [id], onDelete: Cascade)
  brandName             String
  productName           String
  industry              String
  accentColor           String
  overviewTitle         String
  overviewDescription   String
  operationsTitle       String
  operationsDescription String
  primaryRecords        Json
  workItems             Json
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

model AdminUser {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  displayName         String
  role                String               @default("owner")
  isActive            Boolean              @default(true)
  tenantId            String?
  tenant              ClientTenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  memberships         TenantMembership[]
  secretGrants        SecretAccessGrant[]
  platformAuditEvents PlatformAuditEvent[]
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model TenantMembership {
  id        String       @id @default(uuid())
  tenantId  String
  tenant    ClientTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      AdminUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([tenantId, userId])
  @@index([userId, isActive])
  @@index([tenantId, role])
}

model PlatformAuditEvent {
  id        String        @id @default(uuid())
  actorId   String
  actor     AdminUser     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  tenantId  String?
  tenant    ClientTenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json          @default("{}")
  createdAt DateTime      @default(now())

  @@index([actorId, createdAt])
  @@index([tenantId, createdAt])
  @@index([action, createdAt])
}

model BackendService {
  id             String                 @id @default(uuid())
  key            String                 @unique
  name           String
  scope          String
  category       String
  description    String
  owner          String
  basePath       String
  status         String                 @default("DRAFT")
  defaultEnabled Boolean                @default(false)
  endpoints      Json                   @default("[]")
  requiredRoles  String[]               @default([])
  tags           String[]               @default([])
  configSchema   Json                   @default("{}")
  docsPath       String?
  tenantServices TenantBackendService[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([scope, status])
  @@index([category, status])
}

model TenantBackendService {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         ClientTenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceId      String
  service        BackendService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  isEnabled      Boolean        @default(true)
  status         String         @default("ENABLED")
  config         Json           @default("{}")
  notes          String?
  createdById    String
  createdByEmail String
  updatedById    String
  updatedByEmail String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([tenantId, serviceId])
  @@index([tenantId, status])
  @@index([serviceId, status])
}

model ShamstayProperty {
  id                 String                      @id @default(uuid())
  tenantId           String
  tenant             ClientTenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  slug               String
  address            String
  city               String
  country            String
  description        String?
  propertyType       String
  bedrooms           Int
  bathrooms          Float
  maxGuests          Int
  nightlyRate        Int
  cleaningFee        Int
  currency           String                      @default("USD")
  status             String                      @default("ACTIVE")
  ownerName          String?
  rating             Float?
  amenities          Json                        @default("[]")
  houseRules         Json                        @default("[]")
  photos             Json                        @default("[]")
  latitude           Float?
  longitude          Float?
  reservations       ShamstayReservation[]
  turnovers          ShamstayTurnover[]
  maintenanceTickets ShamstayMaintenanceTicket[]
  ownerPayouts       ShamstayOwnerPayout[]
  payments           ShamstayPayment[]
  availabilityBlocks ShamstayAvailabilityBlock[]
  reviews            ShamstayReview[]
  conversations      ShamstayConversation[]
  wishlistItems      ShamstayWishlistItem[]
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([city, status])
}

model ShamstayGuest {
  id            String                 @id @default(uuid())
  tenantId      String
  tenant        ClientTenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fullName      String
  email         String
  phone         String?
  country       String?
  notes         String?
  reservations  ShamstayReservation[]
  payments      ShamstayPayment[]
  conversations ShamstayConversation[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId, fullName])
}

model ShamstayReservation {
  id               String                 @id @default(uuid())
  tenantId         String
  tenant           ClientTenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId       String
  property         ShamstayProperty       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guestId          String
  guest            ShamstayGuest          @relation(fields: [guestId], references: [id], onDelete: Cascade)
  confirmationCode String
  status           String                 @default("BOOKED")
  checkIn          DateTime
  checkOut         DateTime
  guests           Int
  channel          String
  nightlyRate      Int
  fees             Int                    @default(0)
  taxes            Int                    @default(0)
  totalAmount      Int
  currency         String                 @default("USD")
  notes            String?
  turnovers        ShamstayTurnover[]
  reviews          ShamstayReview[]
  conversations    ShamstayConversation[]
  payments         ShamstayPayment[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([tenantId, confirmationCode])
  @@index([tenantId, status])
  @@index([propertyId, checkIn])
  @@index([guestId, checkIn])
}

model ShamstayTurnover {
  id            String               @id @default(uuid())
  tenantId      String
  tenant        ClientTenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId    String
  property      ShamstayProperty     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservationId String?
  reservation   ShamstayReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  status        String               @default("SCHEDULED")
  scheduledFor  DateTime
  assignedTeam  String?
  checklist     Json                 @default("[]")
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([tenantId, status])
  @@index([propertyId, scheduledFor])
}

model ShamstayMaintenanceTicket {
  id            String           @id @default(uuid())
  tenantId      String
  tenant        ClientTenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId    String
  property      ShamstayProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title         String
  category      String
  priority      String
  status        String           @default("OPEN")
  reportedAt    DateTime         @default(now())
  dueAt         DateTime?
  resolvedAt    DateTime?
  vendorName    String?
  estimatedCost Int?
  actualCost    Int?
  currency      String           @default("USD")
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([tenantId, status])
  @@index([propertyId, status])
  @@index([priority, status])
}

model ShamstayOwnerPayout {
  id           String           @id @default(uuid())
  tenantId     String
  tenant       ClientTenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId   String
  property     ShamstayProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  periodStart  DateTime
  periodEnd    DateTime
  grossRevenue Int
  expenses     Int              @default(0)
  platformFees Int              @default(0)
  netPayout    Int
  currency     String           @default("USD")
  status       String           @default("DRAFT")
  paidAt       DateTime?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([tenantId, status])
  @@index([propertyId, periodStart])
}

model ShamstayPayment {
  id                String               @id @default(uuid())
  tenantId          String
  tenant            ClientTenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId        String?
  property          ShamstayProperty?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  reservationId     String?
  reservation       ShamstayReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guestId           String?
  guest             ShamstayGuest?       @relation(fields: [guestId], references: [id], onDelete: SetNull)
  provider          String               @default("manual")
  providerReference String?
  type              String               @default("CHARGE")
  status            String               @default("PENDING")
  amount            Int
  currency          String               @default("USD")
  fees              Int                  @default(0)
  taxes             Int                  @default(0)
  refundAmount      Int                  @default(0)
  paidAt            DateTime?
  refundedAt        DateTime?
  notes             String?
  metadata          Json                 @default("{}")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([tenantId, providerReference])
  @@index([tenantId, status])
  @@index([propertyId, status])
  @@index([reservationId, status])
  @@index([guestId, status])
}

model ShamstayAvailabilityBlock {
  id                  String           @id @default(uuid())
  tenantId            String
  tenant              ClientTenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId          String
  property            ShamstayProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  startDate           DateTime
  endDate             DateTime
  reason              String
  status              String           @default("BLOCKED")
  nightlyRateOverride Int?
  minimumNights       Int?
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([tenantId, status])
  @@index([propertyId, startDate])
}

model ShamstayReview {
  id            String               @id @default(uuid())
  tenantId      String
  tenant        ClientTenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId    String
  property      ShamstayProperty     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservationId String?
  reservation   ShamstayReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guestName     String
  rating        Int
  comment       String
  status        String               @default("PENDING")
  hostResponse  String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([tenantId, status])
  @@index([propertyId, status])
}

model ShamstayConversation {
  id            String               @id @default(uuid())
  tenantId      String
  tenant        ClientTenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId    String?
  property      ShamstayProperty?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  reservationId String?
  reservation   ShamstayReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guestId       String?
  guest         ShamstayGuest?       @relation(fields: [guestId], references: [id], onDelete: SetNull)
  guestName     String
  guestEmail    String?
  subject       String
  status        String               @default("OPEN")
  source        String               @default("WEBSITE")
  messages      ShamstayMessage[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([tenantId, status])
  @@index([propertyId, status])
  @@index([reservationId, status])
}

model ShamstayMessage {
  id             String               @id @default(uuid())
  conversationId String
  conversation   ShamstayConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     String
  senderName     String
  body           String
  attachments    Json                 @default("[]")
  readAt         DateTime?
  createdAt      DateTime             @default(now())

  @@index([conversationId, createdAt])
}

model ShamstayWishlistItem {
  id         String           @id @default(uuid())
  tenantId   String
  tenant     ClientTenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitorKey String
  propertyId String
  property   ShamstayProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@unique([tenantId, visitorKey, propertyId])
  @@index([propertyId, createdAt])
}

model RealEstateListing {
  id             String                   @id @default(uuid())
  tenantId       String
  tenant         ClientTenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title          String
  slug           String
  propertyType   String
  address        String
  district       String
  city           String
  description    String?
  price          Int
  currency       String                   @default("USD")
  status         String                   @default("DRAFT")
  listingPurpose String                   @default("SALE")
  bedrooms       Int?
  bathrooms      Float?
  sizeSqm        Int?
  lotSizeSqm     Int?
  yearBuilt      Int?
  ownerName      String?
  assignedAgent  String?
  features       Json                     @default("[]")
  photos         Json                     @default("[]")
  latitude       Float?
  longitude      Float?
  publishedAt    DateTime?
  leads          RealEstateLead[]
  viewings       RealEstateViewing[]
  offers         RealEstateOffer[]
  commissions    RealEstateCommission[]
  savedListings  RealEstateSavedListing[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([district, status])
  @@index([city, status])
  @@index([listingPurpose, status])
}

model RealEstateLead {
  id            String              @id @default(uuid())
  tenantId      String
  tenant        ClientTenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listingId     String?
  listing       RealEstateListing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  fullName      String
  email         String?
  phone         String
  source        String
  interestType  String
  budgetMin     Int?
  budgetMax     Int?
  status        String              @default("NEW")
  priority      String              @default("MEDIUM")
  assignedAgent String?
  notes         String?
  viewings      RealEstateViewing[]
  offers        RealEstateOffer[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([tenantId, status])
  @@index([listingId, status])
  @@index([assignedAgent, status])
}

model RealEstateViewing {
  id            String            @id @default(uuid())
  tenantId      String
  tenant        ClientTenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listingId     String
  listing       RealEstateListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  leadId        String?
  lead          RealEstateLead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  scheduledFor  DateTime
  status        String            @default("SCHEDULED")
  assignedAgent String?
  notes         String?
  feedback      Json              @default("{}")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([tenantId, status])
  @@index([listingId, scheduledFor])
}

model RealEstateOffer {
  id          String                 @id @default(uuid())
  tenantId    String
  tenant      ClientTenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listingId   String
  listing     RealEstateListing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  leadId      String
  lead        RealEstateLead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  amount      Int
  currency    String                 @default("USD")
  status      String                 @default("SUBMITTED")
  submittedAt DateTime               @default(now())
  expiresAt   DateTime?
  terms       Json                   @default("{}")
  notes       String?
  commissions RealEstateCommission[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([tenantId, status])
  @@index([listingId, status])
  @@index([leadId, status])
}

model RealEstateCommission {
  id              String             @id @default(uuid())
  tenantId        String
  tenant          ClientTenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listingId       String?
  listing         RealEstateListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  offerId         String?
  offer           RealEstateOffer?   @relation(fields: [offerId], references: [id], onDelete: SetNull)
  agentName       String
  grossCommission Int
  brokerageShare  Int
  agentShare      Int
  currency        String             @default("USD")
  status          String             @default("PENDING")
  dueAt           DateTime?
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([tenantId, status])
  @@index([agentName, status])
}

model RealEstateSavedListing {
  id         String            @id @default(uuid())
  tenantId   String
  tenant     ClientTenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitorKey String
  listingId  String
  listing    RealEstateListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())

  @@unique([tenantId, visitorKey, listingId])
  @@index([listingId, createdAt])
}

model RealEstateSavedSearch {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         ClientTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitorKey     String
  label          String
  filters        Json         @default("{}")
  alertFrequency String       @default("WEEKLY")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([tenantId, visitorKey])
  @@index([tenantId, alertFrequency])
}

model PeptraceBatch {
  id               String                @id @default(uuid())
  tenantId         String
  tenant           ClientTenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batchCode        String
  vendorId         String
  peptideId        String
  productId        String?
  manufacturedAt   DateTime?
  receivedAt       DateTime?
  status           String                @default("RECEIVED")
  quantityVials    Int
  vialSizeMg       Int
  storageCondition String?
  notes            String?
  certificates     PeptraceCertificate[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([tenantId, batchCode])
  @@index([tenantId, status])
  @@index([vendorId, status])
  @@index([peptideId, status])
}

model PeptraceCertificate {
  id                String        @id @default(uuid())
  tenantId          String
  tenant            ClientTenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batchId           String
  batch             PeptraceBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  labTestId         String?
  certificateNumber String
  status            String        @default("DRAFT")
  issuedAt          DateTime?
  expiresAt         DateTime?
  documentUrl       String?
  summary           Json          @default("{}")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([tenantId, certificateNumber])
  @@index([tenantId, status])
  @@index([batchId, status])
}

model Secret {
  id             String              @id @default(uuid())
  tenantId       String
  tenant         ClientTenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  labels         Json                @default("{}")
  versionCounter Int                 @default(0)
  versions       SecretVersion[]
  grants         SecretAccessGrant[]
  auditEvents    SecretAuditEvent[]
  createdById    String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, updatedAt])
}

model SecretVersion {
  id                String             @id @default(uuid())
  secretId          String
  secret            Secret             @relation(fields: [secretId], references: [id], onDelete: Cascade)
  version           Int
  state             String             @default("ENABLED")
  encryptedValue    Bytes?
  encryptionIv      Bytes?
  authenticationTag Bytes?
  checksum          String?
  encryptionKeyId   String
  createdById       String
  createdAt         DateTime           @default(now())
  destroyedAt       DateTime?
  auditEvents       SecretAuditEvent[]

  @@unique([secretId, version])
  @@index([secretId, state])
}

model SecretAccessGrant {
  id        String       @id @default(uuid())
  tenantId  String
  tenant    ClientTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  secretId  String
  secret    Secret       @relation(fields: [secretId], references: [id], onDelete: Cascade)
  userId    String
  user      AdminUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([secretId, userId])
  @@index([tenantId, userId])
}

model SecretAuditEvent {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          ClientTenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  secretId        String?
  secret          Secret?        @relation(fields: [secretId], references: [id], onDelete: SetNull)
  secretVersionId String?
  secretVersion   SecretVersion? @relation(fields: [secretVersionId], references: [id], onDelete: SetNull)
  actorId         String
  action          String
  metadata        Json           @default("{}")
  createdAt       DateTime       @default(now())

  @@index([tenantId, createdAt])
  @@index([secretId, createdAt])
}

model Vendor {
  id            String          @id @default(uuid())
  displayName   String
  slug          String          @unique
  overallRating Float
  products      VendorProduct[]
  tests         LabTest[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model VendorProduct {
  id                 String   @id @default(uuid())
  label              String
  slug               String
  peptideId          String
  vendorId           String
  priceMg            Float
  rating             Float
  doseMg             Float
  purityPercent      Float
  labelAccuracyDelta Float
  testsCount         Int
  peptide            Peptide  @relation(fields: [peptideId], references: [id], onDelete: Cascade)
  vendor             Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([vendorId, slug])
}

model Peptide {
  id        String          @id @default(uuid())
  label     String
  slug      String          @unique
  products  VendorProduct[]
  tests     LabTest[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Lab {
  id           String    @id @default(uuid())
  displayName  String
  slug         String    @unique
  partnerSince DateTime
  tests        LabTest[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model LabTest {
  id                String    @id @default(uuid())
  labId             String
  vialSizeMg        Int
  vendorId          String
  resultsReleasedAt DateTime?
  testingStatus     String
  peptideId         String
  assay             String
  purityPercent     Float?
  labelClaimPercent Float?
  lab               Lab       @relation(fields: [labId], references: [id])
  peptide           Peptide   @relation(fields: [peptideId], references: [id])
  vendor            Vendor    @relation(fields: [vendorId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model ApiSurface {
  id        String   @id @default(uuid())
  group     String   @unique
  routes    String[]
  owner     String
  readiness String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AccountWorkItem {
  id        String   @id @default(uuid())
  account   String
  kind      String
  priority  String
  dueAt     DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
