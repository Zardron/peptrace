{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@peptrace/api-client": ["../packages/api-client/src/index.ts"],
      "@peptrace/domain": ["../packages/domain/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "references": [{ "path": "../packages/domain" }, { "path": "../packages/api-client" }]
}
