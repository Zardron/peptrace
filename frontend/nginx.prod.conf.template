# Production TLS config for the frontend container. Mounted by
# docker-compose.prod.yml into /etc/nginx/templates/ — the nginx image's
# entrypoint runs envsubst on it (only ${PEPTRACE_DOMAIN} and
# ${ADMIN_PORTAL_DOMAIN} are defined in the container environment; nginx's
# own $variables pass through untouched).
#
# Port 80 exists only for the Let's Encrypt HTTP-01 challenge (webroot), the
# container healthcheck, and redirecting everything else to HTTPS. The actual
# site is served on 443; /api is proxied to the api container (no Traefik on
# the production VPS). A second 443 server block below routes
# ADMIN_PORTAL_DOMAIN to the admin-portal container (shared-services/admin-portal,
# joined to this project's default Docker network) — there's no Traefik to
# front that service on this server either.

server {
    listen 80;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location /health {
        access_log off;
        return 200 "ok";
        add_header Content-Type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate /etc/letsencrypt/live/${PEPTRACE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PEPTRACE_DOMAIN}/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co https://maps.googleapis.com https://maps.gstatic.com; worker-src 'self' blob:; upgrade-insecure-requests" always;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /health {
        access_log off;
        return 200 "ok";
        add_header Content-Type text/plain;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    }

    # Hashed build artifacts are immutable. Never fall back to index.html here:
    # a missing asset must be a 404, not an HTML page that breaks module loads.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    }

    # Resolved at request time via Docker's embedded DNS so nginx starts even
    # if the api container isn't up yet.
    location /api/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        # set must come before rewrite: `rewrite ... break` skips any
        # remaining rewrite-phase directives in the block.
        set $api_upstream http://api:3000;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
        # Always revalidate the HTML shell so a new deploy takes effect on the
        # next page load instead of serving a stale asset manifest.
        add_header Cache-Control "no-cache";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co https://maps.googleapis.com https://maps.gstatic.com; worker-src 'self' blob:; upgrade-insecure-requests" always;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${ADMIN_PORTAL_DOMAIN};

    # Same cert lineage as the main site: it must be issued covering both
    # PEPTRACE_DOMAIN and ADMIN_PORTAL_DOMAIN (see deploy.yml).
    ssl_certificate /etc/letsencrypt/live/${PEPTRACE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PEPTRACE_DOMAIN}/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests" always;

    location /health {
        access_log off;
        return 200 "ok";
        add_header Content-Type text/plain;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    }

    # admin-portal container (shared-services/admin-portal's own compose
    # project, joined to this project's default network). Resolved at request
    # time via Docker's embedded DNS so nginx starts even if that container
    # isn't up yet.
    location / {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $admin_portal_upstream http://admin-portal:80;
        proxy_pass $admin_portal_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
